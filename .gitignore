# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# 데모 모드 빌드(next.config.ts 의 distDir 주석 참조)
/.next-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- 이음(Ieum) 추가 규칙 ---
# ⚠️ 제출물에 깃헙 주소가 포함된다. 키가 커밋되면 그 순간 유출이다.
!.env.example
*.key
*.pem
secrets/
.claude/

# KRDS 공식 컴포넌트 킷 (제3자 참조 자료. src/styles/krds-tokens.css로 필요한 부분만 복사해 사용)
/design/krds/

# 빌드·캐시
.next/
.turbo/

# 비밀번호를 채워 넣은 시드 사본. 붙여넣기용이며 절대 커밋하지 않는다.
supabase/seed/*.local.sql

# 자문·조사 원본 (`발전/`)
#
# 현직 관리자와 주고받은 카카오톡 원문과 그 화면 사진 20장이 들어 있다.
# **실명이 그대로 적혀 있고 이 저장소는 공개**이므로 올리지 않는다.
# 여기서 나온 결론은 docs/기획서.md 와 docs/발전계획.md 에 옮겨 적었고,
# 그 문서들에는 이름이 아니라 「자문」으로만 남는다.
/발전/

# Jupyter 자동 저장본.
#
# 이 폴더가 빠져 있어서 supabase/seed/.ipynb_checkpoints/demo.local-checkpoint.sql 이
# 커밋됐고, 거기에는 위에서 막아 둔 **데모 계정 비밀번호가 그대로 들어 있었다.**
# 파일 이름 규칙(*.local.sql)으로만 막으면 사본의 사본이 다른 이름으로 새어 나간다.
.ipynb_checkpoints/
