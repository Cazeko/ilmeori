# =============================================================================
# 이음(Ieum) 환경변수 예시
#
# ⚠️ 이 파일만 커밋한다. 실제 값이 담긴 .env.local은 절대 커밋하지 않는다.
#    제출물에 코드 깃헙 주소가 포함되므로, 키 유출이 가장 현실적인 사고 경로다.
# =============================================================================

# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon key — 브라우저에 노출되어도 안전하다. 실제 접근제어는 DB의 RLS가 수행한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# service_role 키는 이 프로젝트에서 사용하지 않는다.
# RLS를 전면 우회하므로, 한 번이라도 쓰면 "권한은 DB가 강제한다"는 전제가 무너진다.
# 관리 작업은 애플리케이션이 아니라 SQL 마이그레이션으로 처리한다.
# -----------------------------------------------------------------------------

# AI 인수인계서 생성 (8/14~15 구현 예정). 서버에서만 사용하며 클라이언트에 노출하지 않는다.
# ANTHROPIC_API_KEY=
